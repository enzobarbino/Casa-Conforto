generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StatusProduto {
  PARA_REVISAR
  NO_AR
  PRECO_MUDOU
  OFERTA_ACABOU
  OCULTO
  IGNORADO
}

enum OrigemClique {
  SITE
  WHATSAPP
  BIO
}

enum StatusComissao {
  PENDENTE
  CONFIRMADA
}

enum FrequenciaBusca {
  DIARIA
  A_CADA_2_DIAS
  SEMANAL
}

model Produto {
  id                 String        @id @default(cuid())
  mlItemId           String        @unique
  titulo             String
  descricao          String
  descricaoOriginal  String        @default("")
  destaques          String[]
  categoria          String
  mlCategoriaId      String?
  imagens            String[]
  atributos          Json          @default("[]")
  preco              Decimal       @db.Decimal(10, 2)
  precoAnterior      Decimal?      @db.Decimal(10, 2)
  precoConsultadoEm  DateTime
  comissaoPercentual Decimal?      @db.Decimal(5, 4)
  linkAnuncio        String
  linkAfiliado       String?
  status             StatusProduto @default(PARA_REVISAR)
  alertas            String[]      @default([])
  publicadoEm        DateTime?
  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt
  cliques            Clique[]
  comissoes          Comissao[]

  @@index([status])
  @@index([categoria])
}

model Clique {
  id        String       @id @default(cuid())
  produtoId String
  produto   Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  origem    OrigemClique @default(SITE)
  criadoEm  DateTime     @default(now())

  @@index([produtoId])
  @@index([criadoEm])
}

model Comissao {
  id         String         @id @default(cuid())
  produtoId  String?
  produto    Produto?       @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  valor      Decimal        @db.Decimal(10, 2)
  status     StatusComissao @default(PENDENTE)
  data       DateTime
  observacao String         @default("")
  criadoEm   DateTime       @default(now())

  @@index([status])
  @@index([data])
}

model Configuracao {
  id                      Int             @id @default(1)
  categoriasPermitidas    String[]
  frequenciaBusca         FrequenciaBusca @default(DIARIA)
  publicarAutomaticamente Boolean         @default(false)
  atualizadoEm            DateTime        @updatedAt
}
